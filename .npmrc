# ── pnpm configuration ──────────────────────────────────────────────────────
# The pnpm version is pinned by `packageManager` in package.json and resolved
# by Corepack.  To change versions:  corepack use pnpm@11
#
# ⚠️ NEVER put credentials here (_auth, _authToken, _password) — this file is
# committed. pnpm also refuses to expand credential env-var placeholders from a
# project-level .npmrc as an exfiltration defence. Registry auth belongs in
# ~/.npmrc or a masked CI secret.
#
# ⚠️ Build-script settings do NOT live here or in package.json any more.
# pnpm 11 reads `allowBuilds` from pnpm-workspace.yaml.

# Enforce the `engines` ranges instead of only warning about them.
engine-strict=true

# pnpm's symlinked node_modules is intentional: it makes phantom dependencies
# (importing a package you never declared) fail loudly. Next 16 + Turbopack,
# Vitest 3 and google-spreadsheet all handle symlinks correctly, so there is no
# reason to reach for shamefully-hoist.

# Appwrite and google-auth-library declare loose peer ranges that resolve fine
# in practice. Warn rather than abort the install.
strict-peer-dependencies=false

# Keep transitive duplicates down when several packages peer on the same lib
# (react, eslint, prettier, google-auth-library).
dedupe-peer-dependents=true

# Deterministic installs in CI.
prefer-frozen-lockfile=true